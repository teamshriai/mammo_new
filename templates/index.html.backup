<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SHRI-AI 1-5 Year Risk Prediction</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --blue:#2563eb; --blue-dark:#1d4ed8; --blue-light:#eff6ff;
      --green:#16a34a; --green-light:#f0fdf4; --green-border:#bbf7d0;
      --gray-50:#f1f4f8; --gray-100:#f1f5f9; --gray-200:#e2e8f0;
      --gray-300:#cbd5e1; --gray-400:#94a3b8; --gray-500:#64748b;
      --gray-600:#475569; --gray-700:#334155; --gray-900:#0f172a;
      --radius:14px; --shadow:0 1px 3px rgba(0,0,0,.06),0 6px 24px rgba(0,0,0,.07);
      --max-w:980px;
    }
    html,body { min-height:100%; background:var(--gray-50); color:var(--gray-900);
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
      font-size:14px; line-height:1.6; }

    /* HEADER */
    header { background:var(--gray-50); padding:1.2rem 0 1rem; }
    .header-inner { max-width:var(--max-w); margin:0 auto; padding:0 2rem; display:flex; align-items:center; gap:1rem; }
    .logo-box { background:#fff; border:1px solid var(--gray-200); border-radius:14px;
      width:88px; height:88px; display:flex; align-items:center; justify-content:center;
      flex-shrink:0; padding:6px; box-shadow:0 2px 8px rgba(0,0,0,.08); overflow:hidden; }
    .logo-box img { width:74px; height:74px; object-fit:contain; display:block; }
    .header-title { flex:1; }
    .header-title h1 { font-size:1.7rem; font-weight:800; color:var(--gray-900); letter-spacing:-.025em; }
    .header-subtitle { font-size:.95rem; color:var(--gray-500); white-space:nowrap; }
    .btn-new-exam { padding:.6rem 1.2rem; background:var(--gray-900); color:#fff; border:none;
      border-radius:9px; font-size:.9rem; font-weight:600; cursor:pointer;
      display:none; align-items:center; gap:.4rem; transition:background .15s; }
    .btn-new-exam:hover { background:var(--gray-700); }
    .btn-new-exam.visible { display:flex; }

    /* MAIN */
    main { max-width:var(--max-w); margin:0 auto; padding:0 2rem 3rem; }
    .card { background:#fff; border:1px solid var(--gray-200); border-radius:var(--radius);
      box-shadow:var(--shadow); padding:1.8rem 2.2rem; }

    /* PATIENT ROW */
    .patient-row { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; margin-bottom:1.5rem; }
    .field { position:relative; }
    .field label { display:block; font-size:.9rem; font-weight:600; color:var(--gray-700); margin-bottom:.45rem; }
    .field input { width:100%; padding:.65rem 1rem; border:1px solid var(--gray-300);
      border-radius:9px; font-size:.95rem; color:var(--gray-900); outline:none;
      background:#fff; transition:border-color .15s,box-shadow .15s; }
    .field input::placeholder { color:var(--gray-400); }
    .field input:focus { border-color:var(--blue); box-shadow:0 0 0 3px rgba(37,99,235,.12); }

    /* AUTOCOMPLETE */
    .autocomplete-list { position:absolute; top:calc(100% + 4px); left:0; right:0;
      background:#fff; border:1px solid var(--gray-200); border-radius:10px;
      box-shadow:0 8px 24px rgba(0,0,0,.12); z-index:50; overflow:hidden; display:none; }
    .autocomplete-list.open { display:block; }
    .autocomplete-item { padding:.6rem 1rem; font-size:.95rem; cursor:pointer;
      color:var(--gray-900); transition:background .1s; }
    .autocomplete-item:hover { background:var(--blue-light); }

    /* UPLOAD MODES GRID */
    .upload-modes { display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1rem; }
    @media (max-width:768px) { .upload-modes { grid-template-columns:1fr; } }

    /* DROP ZONE */
    .drop-zone { border:2px dashed #c5cfe0; border-radius:var(--radius); background:#f7f9fc;
      padding:2rem 1.5rem 1.8rem; text-align:center; cursor:pointer;
      transition:border-color .18s,background .18s; position:relative; }
    .drop-zone:hover,.drop-zone.drag-over { border-color:var(--blue); background:var(--blue-light); }
    .drop-zone input[type="file"] { position:absolute; inset:0; opacity:0; cursor:pointer; width:100%; height:100%; }
    .folder-icon-wrap { width:48px; height:48px; background:var(--blue); border-radius:50%;
      display:flex; align-items:center; justify-content:center; margin:0 auto .8rem; }
    .folder-icon-wrap svg { width:24px; height:24px; }
    .drop-zone h3 { font-size:1rem; font-weight:700; color:var(--gray-900); margin-bottom:.25rem; }
    .drop-zone .drop-hint { font-size:.85rem; color:var(--gray-500); margin-bottom:1rem; }
    .btn-choose { display:inline-block; padding:.55rem 1.5rem; background:var(--blue); color:#fff;
      border:none; border-radius:9px; font-size:.9rem; font-weight:700; pointer-events:none; }
    .drop-zone:hover .btn-choose { background:var(--blue-dark); }
    .drop-zone .folder-req { font-size:.75rem; color:var(--gray-500); margin-top:.8rem; }

    /* REMOTE ZONE */
    .remote-zone { border:2px dashed #c5cfe0; border-radius:var(--radius); background:#f7f9fc;
      padding:2rem 1.5rem 1.8rem; text-align:center; transition:border-color .18s,background .18s; }
    .remote-zone.active { border-color:var(--blue); background:var(--blue-light); }
    .remote-select { width:100%; padding:.65rem 1rem; border:1px solid var(--gray-300);
      border-radius:9px; font-size:.9rem; color:var(--gray-900); background:#fff;
      margin-top:1rem; cursor:pointer; transition:border-color .15s; }
    .remote-select:hover { border-color:var(--blue); }
    .remote-select:disabled { background:var(--gray-100); cursor:not-allowed; }
    .btn-load-remote { padding:.55rem 1.5rem; background:var(--blue); color:#fff;
      border:none; border-radius:9px; font-size:.9rem; font-weight:700; cursor:pointer;
      margin-top:.8rem; transition:background .15s; }
    .btn-load-remote:hover { background:var(--blue-dark); }
    .btn-load-remote:disabled { background:var(--gray-400); cursor:not-allowed; }
    .remote-zone .mode-badge { display:inline-block; padding:.3rem .7rem; background:var(--blue);
      color:#fff; font-size:.7rem; font-weight:700; border-radius:99px; margin-bottom:.5rem; }

    /* FILE STATUS BOX */
    .file-status-box { display:none; border:1px solid var(--green-border); border-radius:10px;
      background:var(--green-light); padding:.85rem 1.2rem; margin-top:1rem; }
    .file-status-box.visible { display:block; }
    .file-status-box.error { border-color:#fecaca; background:#fef2f2; }
    .file-status-title { font-size:.95rem; font-weight:700; color:var(--green); margin-bottom:.35rem; }
    .file-status-box.error .file-status-title { color:#dc2626; }
    .file-status-list { font-size:.85rem; color:var(--gray-600);
      display:flex; flex-wrap:wrap; gap:.2rem .1rem; align-items:center; }
    .file-tag { display:inline-flex; align-items:center; gap:.25rem; }
    .file-tag .fstatus { font-weight:700; color:var(--green); }
    .file-tag .fstatus.missing { color:#dc2626; }
    .file-dot { color:var(--gray-400); margin:0 .3rem; }

    /* RUN ROW */
    .run-row { display:flex; align-items:center; gap:1.2rem; margin-top:1.2rem; }
    .btn-run-inference { flex-shrink:0; padding:.65rem 1.4rem; background:var(--blue); color:#fff;
      border:none; border-radius:99px; font-size:.95rem; font-weight:700; cursor:pointer; transition:background .15s; }
    .btn-run-inference:hover { background:var(--blue-dark); }
    .run-note { font-size:.86rem; color:var(--gray-500); }
    .bottom-disclaimer { font-size:.84rem; color:var(--gray-500);
      margin-top:1.8rem; padding-top:1.4rem; border-top:1px solid var(--gray-200); }

    /* ── MODAL ── */
    .modal-overlay { display:none; position:fixed; inset:0; background:rgba(15,23,42,.65);
      backdrop-filter:blur(4px); z-index:100; align-items:center; justify-content:center; }
    .modal-overlay.active { display:flex; }
    .modal-box { background:#fff; border-radius:20px; padding:2.2rem 3rem;
      min-width:400px; text-align:center; box-shadow:0 20px 60px rgba(0,0,0,.25); }

    /* Spinner only (inference stage) */
    .modal-spinner { width:68px; height:68px; border:5px solid #e2e8f0;
      border-top-color:var(--blue); border-radius:50%;
      animation:spin .9s linear infinite; margin:0 auto 1.8rem; }
    @keyframes spin { to { transform:rotate(360deg); } }
    .modal-box h2 { font-size:1.35rem; font-weight:800; color:var(--gray-900); margin-bottom:.5rem; }
    .modal-box .modal-sub { font-size:.95rem; color:var(--gray-500); margin-bottom:1.8rem; }

    /* Progress bar (upload stage) */
    .progress-wrap { margin-bottom:1.5rem; }
    .progress-track { height:8px; background:var(--gray-200); border-radius:99px; overflow:hidden; margin-bottom:.5rem; }
    .progress-fill { height:100%; background:var(--blue); border-radius:99px; transition:width .3s ease; width:0%; }
    .progress-pct { font-size:.9rem; color:var(--gray-600); font-weight:600; }

    .btn-cancel { padding:.7rem 2.5rem; background:#dc2626; color:#fff; border:none;
      border-radius:99px; font-size:1.15rem; font-weight:700; cursor:pointer; }
    .btn-cancel:hover { background:#b91c1c; }

    /* RESULTS */
    #resultsSection { display:none; }
    #resultsSection.active { display:block; }
    .results-grid { display:grid; grid-template-columns:1fr 1fr; gap:1rem; align-items:start; }
    @media (max-width:900px) { .results-grid { grid-template-columns:1fr; } }
    .chart-panel h3,.images-panel h3 { font-size:1.15rem; font-weight:700; color:var(--gray-700); margin-bottom:1rem; }
    .chart-wrap { position:relative; height:280px; }
    .risk-badge { display:inline-block; margin-top:1.2rem; padding:.4rem 1rem;
      border-radius:99px; font-size:.95rem; font-weight:700; }
    .risk-badge.low { background:#dcfce7; color:#166534; }
    .risk-badge.moderate { background:#fef9c3; color:#854d0e; }
    .risk-badge.high { background:#ffedd5; color:#9a3412; }
    .risk-badge.very-high { background:#fee2e2; color:#991b1b; }

    /* IMAGE GRID - 2x2 */
    .images-grid { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
    .img-slot { background:#0f172a; border-radius:10px; overflow:hidden;
      aspect-ratio:4/3; position:relative; display:flex; align-items:center; justify-content:center; }
    .img-slot img { width:100%; height:100%; object-fit:cover; display:block; }
    .img-slot .img-label { position:absolute; bottom:0; left:0; right:0;
      background:rgba(0,0,0,.65); color:#fff; font-size:.78rem;
      font-weight:600; text-align:center; padding:.35rem; }
    .img-slot .no-img { color:var(--gray-500); font-size:.8rem; }
  </style>
</head>
<body>

<header>
  <div class="header-inner">
    <div class="logo-box"><img src="data:image/png;base64," alt="SHRI-AI" /></div>
    <div class="header-title">
      <h1 id="pageTitle">SHRI-AI 1&ndash;5 Year Risk Prediction</h1>
    </div>
    <div class="header-subtitle" id="headerSub">Upload one exam: L-CC, L-MLO, R-CC, R-MLO</div>
    <button class="btn-new-exam" id="btnNewExam" onclick="resetToUpload()">&#8592; New exam</button>
  </div>
</header>

<!-- MODAL -->
<div class="modal-overlay" id="uploadModal">
  <div class="modal-box">
    <div class="modal-spinner"></div>
    <h2 id="modalTitle">Uploading images...</h2>
    <p class="modal-sub" id="modalSub">Uploading mammography files to server</p>

    <!-- Progress bar (upload stage only) -->
    <div class="progress-wrap" id="progressWrap">
      <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
      <div class="progress-pct" id="progressPct">0%</div>
    </div>

    <button class="btn-cancel" onclick="cancelUpload()">Cancel</button>
  </div>
</div>

<main>
  <div class="card">

    <!-- UPLOAD SECTION -->
    <div id="uploadSection">
      <div class="patient-row">
        <div class="field" id="nameField">
          <label for="patientName">Patient name</label>
          <input type="text" id="patientName" placeholder="e.g., Jane Doe" autocomplete="off"
                 oninput="onNameInput(this)" onblur="setTimeout(closeAC,150)" onkeydown="onNameKey(event)" />
          <div class="autocomplete-list" id="acList"></div>
        </div>
        <div class="field">
          <label for="mrn">MRN</label>
          <input type="text" id="mrn" placeholder="demo-mrn" value="demo-mrn" />
        </div>
      </div>

      <div class="drop-zone" id="dropZone"
           ondragover="onDragOver(event)" ondragleave="onDragLeave()" ondrop="onDrop(event)">
        <input type="file" id="folderInput" webkitdirectory multiple onchange="onFolderChange(this)" />
        <div class="folder-icon-wrap">
          <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 8C3 6.895 3.895 6 5 6H13L16 10H27C28.105 10 29 10.895 29 12V24C29 25.105 28.105 26 27 26H5C3.895 26 3 25.105 3 24V8Z" fill="#f59e0b"/>
            <path d="M3 6H12L15 10H3V6Z" fill="#fbbf24"/>
          </svg>
        </div>
        <h3>Upload Mammography Folder</h3>
        <p class="drop-hint">Click to browse or drag and drop your folder here</p>
        <div class="btn-choose">Choose Folder</div>
        <p class="folder-req" id="folderReq">Folder must contain: L-CC.dcm, L-MLO.dcm, R-CC.dcm, R-MLO.dcm</p>
      </div>

      <div class="file-status-box" id="fileStatusBox">
        <div class="file-status-title" id="fileStatusTitle"></div>
        <div class="file-status-list" id="fileStatusList"></div>
      </div>

      <div class="run-row">
        <button class="btn-run-inference" onclick="runInference()">Run inference</button>
        <span class="run-note">This UI never stores uploads. Missing tags are patched in memory.</span>
      </div>

      <div class="bottom-disclaimer">
        FOR RESEARCH/PRESENTATION mammography DICOMs (L/R &times; CC/MLO). This is a research demo; not for clinical decisions.
      </div>
    </div>

    <!-- RESULTS SECTION -->
    <div id="resultsSection">
      <div class="results-grid">

        <!-- LEFT: Images (top) then Chart (below) -->
        <div class="chart-panel">
          <h3>Risk chart</h3>
          <div class="chart-wrap"><canvas id="riskChart"></canvas></div>
          <div id="riskBadge" class="risk-badge"></div>
        </div>

        <!-- RIGHT: 2x2 mammogram images -->
        <div class="images-panel">
          <h3>Uploaded views</h3>
          <div class="images-grid">
            <div class="img-slot" id="imgLCC">
              <span class="no-img">No image</span>
              <div class="img-label">Left CC</div>
            </div>
            <div class="img-slot" id="imgLMLO">
              <span class="no-img">No image</span>
              <div class="img-label">Left MLO</div>
            </div>
            <div class="img-slot" id="imgRCC">
              <span class="no-img">No image</span>
              <div class="img-label">Right CC</div>
            </div>
            <div class="img-slot" id="imgRMLO">
              <span class="no-img">No image</span>
              <div class="img-label">Right MLO</div>
            </div>
          </div>
        </div>

      </div>
      <div class="bottom-disclaimer" style="margin-top:1.2rem;">
        FOR RESEARCH/PRESENTATION mammography DICOMs (L/R &times; CC/MLO). This is a research demo; not for clinical decisions.
      </div>
    </div>

  </div>
</main>

<script>
  /* ── Autocomplete ── */
  let savedNames = ['sanjai','Jane Doe','John Smith'];
  let acIndex = -1;

  function onNameInput(input) {
    const val = input.value.trim().toLowerCase();
    const list = document.getElementById('acList');
    if (!val) { closeAC(); return; }
    const matches = savedNames.filter(n => n.toLowerCase().startsWith(val) && n.toLowerCase() !== val);
    if (!matches.length) { closeAC(); return; }
    list.innerHTML = matches.map(m =>
      `<div class="autocomplete-item" onmousedown="selectAC('${m.replace(/'/g,"\\'")}')"> ${m} </div>`
    ).join('');
    list.classList.add('open');
    acIndex = -1;
  }
  function selectAC(name) { document.getElementById('patientName').value = name; closeAC(); }
  function closeAC() { document.getElementById('acList').classList.remove('open'); acIndex = -1; }
  function onNameKey(e) {
    const items = document.getElementById('acList').querySelectorAll('.autocomplete-item');
    if (e.key==='ArrowDown') { acIndex=Math.min(acIndex+1,items.length-1); highlightAC(items); e.preventDefault(); }
    else if (e.key==='ArrowUp') { acIndex=Math.max(acIndex-1,0); highlightAC(items); e.preventDefault(); }
    else if (e.key==='Enter'&&acIndex>=0) { selectAC(items[acIndex].textContent.trim()); e.preventDefault(); }
    else if (e.key==='Escape') closeAC();
  }
  function highlightAC(items) { items.forEach((el,i)=>el.style.background=i===acIndex?'var(--blue-light)':''); }

  /* ── Files & results ── */
  let folderFiles = [];
  let latestPrediction = null;
  let latestPreviews = {};
  function onDragOver(e) { e.preventDefault(); document.getElementById('dropZone').classList.add('drag-over'); }
  function onDragLeave() { document.getElementById('dropZone').classList.remove('drag-over'); }
  function onDrop(e) { e.preventDefault(); onDragLeave(); folderFiles=Array.from(e.dataTransfer.files); processFiles(); }
  function onFolderChange(input) { folderFiles=Array.from(input.files); processFiles(); }

  const NEEDED = [
    {key:'L-CC',label:'l-cc.dcm'},{key:'L-MLO',label:'l-mlo.dcm'},
    {key:'R-CC',label:'r-cc.dcm'},{key:'R-MLO',label:'r-mlo.dcm'},
  ];

  function processFiles() {
    const box=document.getElementById('fileStatusBox');
    const title=document.getElementById('fileStatusTitle');
    const list=document.getElementById('fileStatusList');
    document.getElementById('folderReq').style.display='none';

    const results=NEEDED.map(n=>({
      label:n.label,
      found:folderFiles.some(f=>f.name.replace(/\.dcm$/i,'').toUpperCase()===n.key)
    }));
    const allFound=results.every(r=>r.found);

    box.classList.add('visible');
    box.classList.toggle('error',!allFound);
    title.textContent = allFound ? '\u2713 All files found!' : '\u2717 Some files missing';
    title.style.color = allFound ? 'var(--green)' : '#dc2626';

    list.innerHTML = results.map((r,i)=>{
      const dot = i<results.length-1 ? '<span class="file-dot">&bull;</span>' : '';
      return `<span class="file-tag">
        <span>${r.found?'\u2713':'\u2717'}</span>
        <span class="fname">${r.label}</span>
        <span>&ndash;</span>
        <span class="${r.found?'fstatus':'fstatus missing'}">${r.found?'Found':'Missing'}</span>
      </span>${dot}`;
    }).join(' ');
  }

  /* ── Modal stages ── */
  let cancelRequested=false;
  let progressTimer=null;
  let riskChartInstance=null;

  function runInference() {
    cancelRequested=false;
    latestPrediction=null;
    latestPreviews={};
    showModalStage('upload');
    animateUpload();
  }

  function showModalStage(stage) {
    const modal=document.getElementById('uploadModal');
    const title=document.getElementById('modalTitle');
    const sub=document.getElementById('modalSub');
    const pw=document.getElementById('progressWrap');

    modal.classList.add('active');

    if (stage==='upload') {
      title.textContent='Uploading images...';
      sub.textContent='Uploading mammography files to server';
      pw.style.display='block';
      document.getElementById('progressFill').style.width='0%';
      document.getElementById('progressPct').textContent='0%';
    } else {
      // inference stage — no progress bar
      title.textContent='Running AI inference...';
      const pName=document.getElementById('patientName').value.trim();
      sub.textContent='Model is analyzing '+(pName ? pName+"'s" : 'the')+' mammography images';
      pw.style.display='none';
    }
  }

  function cancelUpload() {
    cancelRequested=true;
    clearTimeout(progressTimer);
    document.getElementById('uploadModal').classList.remove('active');
  }

  function animateUpload() {
    let pct=0;
    function step() {
      if (cancelRequested) return;
      const inc=pct<30?2:pct<70?3:pct<90?1:0.3;
      pct=Math.min(pct+inc,100);
      document.getElementById('progressFill').style.width=pct+'%';
      document.getElementById('progressPct').textContent=Math.round(pct)+'%';
      if (pct<100) {
        progressTimer=setTimeout(step,70);
      } else {
        // Upload done → switch to inference stage
        progressTimer=setTimeout(()=>{ if(!cancelRequested) startInference(); },400);
      }
    }
    step();
  }

  async function startInference() {
    if (cancelRequested) return;
    showModalStage('inference');
    try {
      const formData = buildFormData();
      const resp = await fetch('/predict', { method:'POST', body: formData });
      const data = await resp.json();
      if (!resp.ok || data.error) throw new Error(data.msg || 'Inference failed');
      latestPrediction = data.prediction;
      latestPreviews = data.previews || {};
      finishAll(true);
    } catch (err) {
      finishAll(false, err.message || String(err));
    }
  }

  function finishAll(ok, msg) {
    document.getElementById('uploadModal').classList.remove('active');
    if (ok) {
      showResults();
    } else {
      showError(msg || 'Inference failed.');
    }
  }

  /* ── Results ── */
  function showResults() {
    const name=document.getElementById('patientName').value.trim();
    if (name && !savedNames.includes(name)) savedNames.unshift(name);

    document.getElementById('uploadSection').style.display='none';
    document.getElementById('resultsSection').classList.add('active');
    document.getElementById('pageTitle').textContent='SHRI-AI 1\u20135 Year Risk for '+(name||'Patient');
    document.getElementById('headerSub').style.display='none';
    document.getElementById('btnNewExam').classList.add('visible');

    const perYear = latestPrediction ? [
      latestPrediction.year_1 || 0,
      latestPrediction.year_2 || 0,
      latestPrediction.year_3 || 0,
      latestPrediction.year_4 || 0,
      latestPrediction.year_5 || 0,
    ] : [0,0,0,0,0];
    const cumulative=perYear.reduce((acc,v,i)=>{acc.push(+((acc[i-1]||0)+v).toFixed(3));return acc;},[]);
    const total5yr=cumulative[4]||0;

    const badge=document.getElementById('riskBadge');
    if (total5yr<5)      { badge.className='risk-badge low';       badge.textContent='Low 5-yr risk: '+total5yr.toFixed(2)+'%'; }
    else if (total5yr<10){ badge.className='risk-badge moderate';   badge.textContent='Moderate 5-yr risk: '+total5yr.toFixed(2)+'%'; }
    else if (total5yr<20){ badge.className='risk-badge high';       badge.textContent='High 5-yr risk: '+total5yr.toFixed(2)+'%'; }
    else                 { badge.className='risk-badge very-high';  badge.textContent='Very high 5-yr risk: '+total5yr.toFixed(2)+'%'; }

    buildChart(perYear,cumulative);
    loadImagePreviews();
  }

  function buildChart(perYear,cumulative) {
    if (riskChartInstance) riskChartInstance.destroy();
    const ctx=document.getElementById('riskChart').getContext('2d');
    riskChartInstance=new Chart(ctx,{
      data:{
        labels:['Year 1','Year 2','Year 3','Year 4','Year 5'],
        datasets:[
          {type:'line',label:'Cumulative risk',data:cumulative,borderColor:'#3b82f6',
           backgroundColor:'rgba(59,130,246,.12)',borderWidth:2.5,pointBackgroundColor:'#3b82f6',
           pointRadius:5,tension:0.35,fill:false,yAxisID:'y'},
          {type:'bar',label:'Per-year risk',data:perYear,
           backgroundColor:'rgba(251,113,133,.65)',borderRadius:5,yAxisID:'y'}
        ]
      },
      options:{
        responsive:true,maintainAspectRatio:false,
        interaction:{mode:'index',intersect:false},
        plugins:{
          legend:{position:'bottom',labels:{boxWidth:24,padding:16,font:{size:12}}},
          tooltip:{callbacks:{label:c=>c.dataset.label+': '+c.parsed.y.toFixed(2)+'%'}}
        },
        scales:{
          y:{beginAtZero:true,ticks:{callback:v=>v+'%',font:{size:11}},grid:{color:'rgba(0,0,0,.05)'}},
          x:{ticks:{font:{size:11}},grid:{display:false}}
        }
      }
    });
  }

  function loadImagePreviews() {
    const map=[
      {key:'l_cc',slot:'imgLCC',label:'Left CC'},
      {key:'l_mlo',slot:'imgLMLO',label:'Left MLO'},
      {key:'r_cc',slot:'imgRCC',label:'Right CC'},
      {key:'r_mlo',slot:'imgRMLO',label:'Right MLO'},
    ];
    map.forEach(({key,slot,label})=>{
      const el=document.getElementById(slot);
      el.innerHTML='<div class="img-label">'+label+'</div>';
      const src = latestPreviews[key];
      if (src) {
        const img=document.createElement('img');
        img.src=src;
        img.onerror=()=>drawPlaceholder(el);
        el.insertBefore(img,el.firstChild);
      } else {
        drawPlaceholder(el);
      }
    });
  }

  function buildFormData() {
    const map = {
      'L-CC':'l_cc',
      'L-MLO':'l_mlo',
      'R-CC':'r_cc',
      'R-MLO':'r_mlo'
    };
    const fd=new FormData();
    for (const key of Object.keys(map)) {
      const file = folderFiles.find(f=>f.name.replace(/\.dcm$/i,'').toUpperCase()===key);
      if (!file) throw new Error('Missing required file '+key+'.dcm');
      fd.append(map[key], file, file.name);
    }
    return fd;
  }

  function showError(msg) {
    const box=document.getElementById('fileStatusBox');
    const title=document.getElementById('fileStatusTitle');
    const list=document.getElementById('fileStatusList');
    box.classList.add('visible','error');
    title.textContent = msg || 'Error occurred';
    title.style.color = '#dc2626';
    list.innerHTML = '';
  }

  function drawPlaceholder(slot) {
    const c=document.createElement('canvas'); c.width=200; c.height=150;
    const ctx=c.getContext('2d');
    ctx.fillStyle='#0f172a'; ctx.fillRect(0,0,200,150);
    ctx.fillStyle='#475569'; ctx.font='11px sans-serif'; ctx.textAlign='center';
    ctx.fillText('No preview available',100,75);
    const img=document.createElement('img'); img.src=c.toDataURL();
    slot.insertBefore(img,slot.firstChild);
  }

  /* ── Reset ── */
  function resetToUpload() {
    document.getElementById('uploadSection').style.display='';
    document.getElementById('resultsSection').classList.remove('active');
    document.getElementById('pageTitle').textContent='SHRI-AI 1\u20135 Year Risk Prediction';
    document.getElementById('headerSub').style.display='';
    document.getElementById('btnNewExam').classList.remove('visible');
    document.getElementById('patientName').value='';
    document.getElementById('fileStatusBox').classList.remove('visible','error');
    document.getElementById('folderReq').style.display='';
    folderFiles=[];
    if (riskChartInstance){ riskChartInstance.destroy(); riskChartInstance=null; }
  }
</script>
</body>
</html>